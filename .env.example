# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="development"

# MongoDB Database Connection String (Optional: automatically uses high-performance memory store if omitted)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/jersey_mention_bd?retryWrites=true&w=majority"

# Authentication Secrets
JWT_SECRET="jersey_mention_bd_jwt_super_secret_key_2026"
JWT_REFRESH_SECRET="jersey_mention_bd_refresh_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Payment Gateways (bKash, Nagad, Rocket, SSLCommerz, Stripe)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

